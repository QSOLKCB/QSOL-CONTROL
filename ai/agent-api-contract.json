{
  "type": "qsol-control-agent-api-contract",
  "protocol": "qsol-control-agent-api/1",
  "schema_version": "1.1.0",
  "transport": "jsonl-stdio",
  "request_protocol": "qsol-control-agent-request/1",
  "response_protocol": "qsol-control-agent-response/1",
  "error_protocol": "qsol-control-agent-error/1",
  "request_schema": "schema/agent-api-request.schema.json",
  "response_schema": "schema/agent-api-response.schema.json",
  "runtime": "api/dispatcher.py",
  "transport_runtime": "api/stdio.py",
  "cli": "tools/agent_api.py",
  "authority": "orchestration-only",
  "caller_kinds": ["human", "ai"],
  "caller_authority": {
    "human": "operator-orchestration-only",
    "ai": "operator-orchestration-only",
    "equal_epistemic_privilege": true
  },
  "operations": [
    {"name": "control.health", "mutation": false, "authority": "status-only"},
    {"name": "control.capabilities", "mutation": false, "authority": "capability-discovery-only"},
    {"name": "control.ask", "mutation": true, "authority": "orchestration-only"},
    {"name": "control.file.put", "mutation": true, "authority": "storage-only"},
    {"name": "control.file.get", "mutation": false, "authority": "storage-reference-only"},
    {"name": "control.collection.create", "mutation": true, "authority": "storage-only"},
    {"name": "control.collection.snapshot", "mutation": false, "authority": "storage-only"},
    {"name": "control.collection.search", "mutation": false, "authority": "retrieval-only"},
    {"name": "control.run.get", "mutation": false, "authority": "render-only"},
    {"name": "control.run.compare", "mutation": false, "authority": "comparison-only"},
    {"name": "control.replay.classify", "mutation": false, "authority": "classification-only"},
    {"name": "control.replay.execute", "mutation": true, "authority": "orchestration-and-comparison-only"},
    {"name": "control.replay.get", "mutation": false, "authority": "comparison-only"},
    {"name": "control.research.timeline", "mutation": false, "authority": "longitudinal-comparison-only"},
    {"name": "control.evidence.get", "mutation": false, "authority": "evidence-reference-view-only"},
    {"name": "control.council.get", "mutation": false, "authority": "render-and-reference-only"},
    {"name": "control.models.get", "mutation": false, "authority": "reproducibility-metadata-only"},
    {"name": "control.memory.get", "mutation": false, "authority": "navigation-and-storage-addressing-only"},
    {"name": "control.memory.trace", "mutation": false, "authority": "navigation-and-storage-addressing-only"}
  ],
  "limits": {
    "max_request_bytes": 8388608,
    "max_response_bytes": 8388608,
    "max_requests_per_caller_per_process": 1000,
    "max_mutations_per_caller_per_process": 200,
    "max_requests_per_process": 1000,
    "max_mutations_per_process": 200,
    "caller_id_is_trusted_quota_identity": false,
    "max_upload_bytes": 4194304,
    "max_model_states_per_response": 100,
    "max_lattice_records_per_response": 1000,
    "max_lattice_runs_per_trace": 100,
    "max_research_timeline_runs": 500
  },
  "input_hardening": {
    "duplicate_json_members_rejected": true,
    "non_standard_json_numeric_constants_rejected": true,
    "unknown_operation_parameters_rejected": true,
    "council_parameters_preflight_before_run_creation": true,
    "scoped_memory_run_id_validated_before_traversal": true,
    "error_envelopes_obey_response_byte_limit": true,
    "replay_ids_preflight_before_execution": true,
    "changed_council_roster_requires_explicit_authorization": true
  },
  "error_codes": [
    "INVALID_JSON",
    "INVALID_REQUEST",
    "UNSUPPORTED_PROTOCOL",
    "UNKNOWN_OPERATION",
    "AUTHORITY_ESCALATION",
    "RESOURCE_LIMIT",
    "QUOTA_EXCEEDED",
    "OPERATION_FAILED"
  ],
  "forbidden_surfaces": {
    "oracle_write_operations": [],
    "nexus_arbitrary_operation_passthrough": false,
    "nexus_worldstore_mutation": false,
    "nexus_vote_weight_override": false,
    "nexus_ballot_override": false,
    "nexus_consensus_threshold_override": false,
    "hidden_chain_of_thought": false,
    "model_mind": false,
    "synthetic_truth_score": false,
    "exact_replay_without_recorded_basis": false
  },
  "shared_runtime": {
    "human_webui_runtime": "webui/runtime.py",
    "agent_api_facade": "api/runtime.py",
    "same_control_store": true,
    "same_interaction_store": true,
    "same_oracle_adapter": true,
    "same_nexus_adapter": true,
    "same_model_state_registry": true,
    "same_lattice_runtime": true,
    "same_replay_runtime": true
  },
  "phase7": {
    "implemented": true,
    "contract": "ai/replay-contract.json",
    "classify_before_execute": true,
    "original_result_immutable": true,
    "current_evidence_distinct_from_original": true,
    "recurring_question_timeline": true
  },
  "invariants": [
    "HUMAN_CALLER_AUTHORITY == AI_CALLER_AUTHORITY",
    "API_ACCESS != EPISTEMIC_PRIVILEGE",
    "CONTROL_CALL != ORACLE_AUTHORITY",
    "CONTROL_CALL != NEXUS_GOVERNANCE",
    "ORIGINAL_RUN != REPLAY_RUN",
    "CURRENT_EVIDENCE != ORIGINAL_EVIDENCE",
    "VOTE != EVIDENCE",
    "CONSENSUS != TRUTH",
    "SEARCH_SCORE != TRUTH",
    "SEMANTIC_SIMILARITY != EVIDENCE_STRENGTH",
    "MODEL_STATE != MODEL_MIND",
    "LATTICE_ADDRESS != TRUTH",
    "VISIBLE_OUTPUT != HIDDEN_CHAIN_OF_THOUGHT"
  ],
  "remote_multi_user_deployment": false
}
