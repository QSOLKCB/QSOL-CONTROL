{
  "type": "qsol-control-nexus-adapter-contract",
  "protocol": "qsol-control-nexus-adapter/1",
  "parent": {
    "repository": "QSOLKCB/QSOL-NEXUS",
    "discovery": ["system.health", "system.operations"],
    "transport": "jsonl_stdio",
    "supported_protocol_major": 0,
    "required_operations": [
      "system.health",
      "system.operations",
      "council.run",
      "world.inspect",
      "receipt.verify"
    ],
    "optional_operations": ["council.epoch.verify"]
  },
  "control_surface": {
    "mutation_operations": ["council.run"],
    "read_or_verify_operations": [
      "system.health",
      "system.operations",
      "world.inspect",
      "receipt.verify",
      "council.epoch.verify"
    ],
    "world_create_exposed": false,
    "arbitrary_operation_passthrough": false,
    "stenographer_operations_used": false
  },
  "council_request": {
    "question": "bounded visible question text",
    "members": "requested seat/model descriptors admitted by NEXUS",
    "evidence_refs": "ordered unique NEXUS WorldStore object references",
    "evidence_state": "explicit caller-supplied evidence classification",
    "mode": "NEXUS mode id",
    "forbidden_control_fields": [
      "vote_weight",
      "epistemic_privilege",
      "ballot",
      "ballots",
      "ballot_commitment",
      "ballot_commitments",
      "consensus_threshold",
      "consensus_numerator",
      "consensus_denominator",
      "roster_authority",
      "worldstore",
      "world_store",
      "world_state"
    ]
  },
  "post_commit_verification": [
    "resolve session_ref through world.inspect",
    "verify WorldStore content address",
    "preserve canonical roster order from committed council_session",
    "preserve phase_order from committed council_session policy",
    "require each phase join order to equal committed roster order",
    "verify each revealed ballot against its NEXUS ballot commitment",
    "require result tally to equal revealed ballots",
    "require result consensus_threshold to equal committed session policy",
    "preserve minority_reports exactly from committed result",
    "resolve and verify receipt_ref through receipt.verify",
    "verify receipt result_ref and replayability against committed session",
    "verify optional Compute Epoch admission receipt when advertised",
    "preserve Council Chair vote_weight_per_seat=1 and epistemic_privilege_per_seat=none when present"
  ],
  "render": {
    "phase_order_source": "nexus_committed_council_session",
    "sealed_ballot_stage": "SEALED_BALLOT",
    "ballot_contents_source": "nexus_committed_council_session",
    "consensus_threshold_source": "nexus_committed_council_session",
    "minority_reports_source": "nexus_committed_council_session",
    "telemetry_authority": "observational_only",
    "truth_score_generated": false
  },
  "persistence": {
    "control_store_only": true,
    "artifact_authority": "reference-only",
    "persisted_artifacts": [
      "council.run public response",
      "council_session WorldStore object",
      "receipt WorldStore object",
      "receipt.verify response",
      "CONTROL verified render",
      "optional epoch admission receipt and verification"
    ],
    "interaction_linking": ["receipt event", "response event"],
    "copies_nexus_governance_authority": false,
    "mutates_nexus_worldstore_directly": false
  },
  "hidden_reasoning": {
    "capture": false,
    "request": false,
    "stenographer_read": false,
    "forbidden_fields_fail_closed": [
      "chain_of_thought",
      "hidden_chain_of_thought",
      "hidden_reasoning",
      "private_reasoning",
      "internal_reasoning",
      "reasoning_trace",
      "scratchpad",
      "private_scratchpad"
    ],
    "visible_phase_submissions_are_hidden_reasoning": false,
    "visible_ballot_rationales_are_hidden_reasoning": false
  },
  "governance_gate": {
    "control_can_alter_vote_weight": false,
    "control_can_alter_ballot_contents": false,
    "control_can_alter_roster_authority": false,
    "control_can_alter_consensus_threshold": false,
    "control_can_rewrite_worldstore_history": false,
    "nexus_owns_worldstore_history": true,
    "nexus_owns_council_governance": true
  },
  "invariants": [
    "CONTROL_INVOKES_COUNCIL != CONTROL_OWNS_COUNCIL",
    "NEXUS_SESSION != CONTROL_REINTERPRETATION",
    "CONSENSUS != EVIDENCE",
    "CONSENSUS != TRUTH",
    "VISIBLE_NEXUS_OUTPUT != HIDDEN_CHAIN_OF_THOUGHT",
    "CONTROL_RECEIPT_COPY != NEXUS_WORLDSTORE_WRITE"
  ]
}
