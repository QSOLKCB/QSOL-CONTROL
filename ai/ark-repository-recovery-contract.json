{
  "type": "qsol-control-ark-repository-recovery-contract",
  "protocol": "qsol-control-ark-repository-recovery/1",
  "schema_version": "1.1.0",
  "container": "qsol-restore-dat/1",
  "runtime": "storage/ark_repository_bundle.py",
  "cli": "tools/repository_recovery.py",
  "bootstrap_schema": "schema/ark-repository-recovery.schema.json",
  "authority": "none",
  "package_shape": {
    "bootstrap": "CONTROL-REPOSITORY-RECOVERY.json",
    "plain_text_map": "RECOVERY-MAP.txt",
    "capsules": "capsules/NNNNNN.dat",
    "multi_capsule": true,
    "maximum_capsules": 10000,
    "maximum_capsule_file_bytes": 75497472,
    "maximum_capsule_payload_bytes": 67108864,
    "maximum_capsule_entries": 1000,
    "maximum_bootstrap_bytes": 4194304,
    "maximum_recovery_map_bytes": 4194304,
    "large_object_transport_chunking": true,
    "large_object_chunk_bytes": 33554432
  },
  "canonical_source": [
    "raw-object-bytes",
    "file-records",
    "collection-descriptors",
    "collection-snapshots",
    "collection-current-heads",
    "interaction-runs",
    "run-events",
    "run-heads",
    "model-state-records",
    "replay-records",
    "replay-reports"
  ],
  "supporting_recovery_contracts": [
    "public-json-schemas-draft-2020-12",
    "qsol-3x3x3-sierpinski-derived-memory/1"
  ],
  "optional_derived_material": {
    "search_index_descriptors": {
      "canonical": false,
      "restored_into_control_index_store": false,
      "payloads_omitted": ["documents", "vectors"],
      "authority": "none"
    },
    "dna_lattice_projections": {
      "canonical": false,
      "restored_as_raw_source": false,
      "codec": "qsol.dna-2bit-codon64/1",
      "default_traversal": "qsol.phi-stride-27/1",
      "authority": "none"
    }
  },
  "canonical_fingerprint_excludes": [
    "search-indexes",
    "dna-lattice-projections",
    "audit-events"
  ],
  "reconstruction": {
    "standard_library_only": true,
    "webui_required": false,
    "original_search_engine_required": false,
    "network_required": false,
    "fresh_target_required": true,
    "source_root_must_preexist": true,
    "raw_objects_streamed_during_export": true,
    "raw_object_hash_verified": true,
    "large_object_chunk_hashes_verified": true,
    "collection_lineage_verified": true,
    "run_event_lineage_verified": true,
    "model_state_identity_verified": true,
    "replay_identity_and_semantics_verified": true,
    "orphan_canonical_records_rejected": true,
    "support_contracts_semantically_revalidated": true,
    "source_inventory_fingerprint_verified": true,
    "untrusted_container_sizes_bounded_before_read": true
  },
  "privacy": {
    "minimum_package_class": "INTERNAL",
    "strictest_source_class_wins": true,
    "strictest_restored_class_recomputed": true,
    "bootstrap_privacy_must_match_recomputed_restored_class": true,
    "restricted_export_requires_allow_flag": true,
    "restricted_export_requires_acknowledgement": true,
    "restricted_export_requires_actor": true
  },
  "boundaries": [
    "RECOVERY_PACKAGE != SEMANTIC_AUTHORITY",
    "RAW_OBJECT_BYTES = CANONICAL",
    "SEARCH_INDEX_DESCRIPTOR != CANONICAL_MEMORY",
    "DNA_PROJECTION != CANONICAL_SOURCE",
    "LATTICE_ADDRESS != TRUTH",
    "HASH_INTEGRITY != EVIDENCE_AUTHORITY",
    "RESTORED_CONTEXT != ORIGINAL_ASSISTANT_INSTANCE"
  ]
}
