{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schema/model-state-archaeology.schema.json",
  "title": "QSOL-CONTROL Future-AI Model-State Archaeology Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_id",
    "protocol",
    "model_state_protocol",
    "state_count",
    "state_ids",
    "run_index",
    "records",
    "provenance_kinds",
    "privacy_class",
    "epistemic_boundary",
    "hidden_chain_of_thought_captured",
    "model_mind_captured",
    "contains_model_artifact_bytes",
    "local_artifact_paths_persisted",
    "artifact_identity_semantics",
    "reconstruction_scope",
    "ui_boundary_label",
    "authority"
  ],
  "properties": {
    "export_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "protocol": {"const": "qsol-control-model-state-archaeology/1"},
    "model_state_protocol": {"const": "qsol-control-model-state/1"},
    "state_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "state_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "run_index": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "model-state.schema.json"}
    },
    "provenance_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["observed", "provider_reported", "locally_verified", "inferred", "unknown"]}
    },
    "privacy_class": {"enum": ["PUBLIC", "INTERNAL", "RESTRICTED"]},
    "epistemic_boundary": {"const": "MODEL_STATE != MODEL_MIND"},
    "hidden_chain_of_thought_captured": {"const": false},
    "model_mind_captured": {"const": false},
    "contains_model_artifact_bytes": {"const": false},
    "local_artifact_paths_persisted": {"const": false},
    "artifact_identity_semantics": {"const": "hashes-and-descriptors-only"},
    "reconstruction_scope": {"const": "externally inspectable computational circumstances; not hidden cognition"},
    "ui_boundary_label": {"const": "Reproducibility metadata — not model mind"},
    "authority": {"const": "reproducibility-archive-only"}
  }
}
