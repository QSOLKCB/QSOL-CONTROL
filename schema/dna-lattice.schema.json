{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schema/dna-lattice.schema.json",
  "title": "QSOL-CONTROL DNA Lattice Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_id",
    "protocol",
    "codec",
    "alphabet",
    "bit_mapping",
    "lattice_profile",
    "traversal_id",
    "traversal_parameters",
    "traversal_rule",
    "byte_length",
    "base_length",
    "padding_bases",
    "codon_count",
    "content_sha256",
    "cells",
    "codon_histogram",
    "derived",
    "rebuildable",
    "authority",
    "storage_claim"
  ],
  "properties": {
    "projection_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "protocol": {"const": "qsol-control-dna-lattice/1"},
    "codec": {"const": "qsol.dna-2bit-codon64/1"},
    "alphabet": {"const": ["A", "C", "G", "T"]},
    "bit_mapping": {"const": {"A": "00", "C": "01", "G": "10", "T": "11"}},
    "lattice_profile": {"const": "qsol-3x3x3-sierpinski-derived-memory/1"},
    "traversal_id": {
      "enum": ["qsol.lexicographic-27/1", "qsol.phi-stride-27/1"]
    },
    "traversal_parameters": {
      "type": "object"
    },
    "traversal_rule": {
      "const": "round_robin_codon_assignment_across_versioned_27_cell_path"
    },
    "byte_length": {"type": "integer", "minimum": 0},
    "base_length": {"type": "integer", "minimum": 0},
    "padding_bases": {"type": "integer", "minimum": 0, "maximum": 2},
    "codon_count": {"type": "integer", "minimum": 0},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cells": {
      "type": "object",
      "minProperties": 27,
      "maxProperties": 27,
      "propertyNames": {"pattern": "^L\\[[0-2],[0-2],[0-2]\\]$"},
      "additionalProperties": {"type": "string", "pattern": "^(?:[ACGT]{3})*$"}
    },
    "codon_histogram": {
      "type": "object",
      "propertyNames": {"pattern": "^(?:[0-9]|[1-5][0-9]|6[0-3])$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "derived": {"const": true},
    "rebuildable": {"const": true},
    "authority": {"const": "none"},
    "storage_claim": {"const": "reversible_recovery_projection_not_compression_claim"}
  },
  "allOf": [
    {
      "if": {"properties": {"traversal_id": {"const": "qsol.lexicographic-27/1"}}},
      "then": {
        "properties": {
          "traversal_parameters": {
            "const": {
              "mode": "lexicographic",
              "modulus": 27,
              "rule": "cell_index(n)=n"
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"traversal_id": {"const": "qsol.phi-stride-27/1"}}},
      "then": {
        "properties": {
          "traversal_parameters": {
            "const": {
              "mode": "fixed-modular-stride",
              "stride": 17,
              "modulus": 27,
              "rule": "cell_index(n)=(17*n) mod 27"
            }
          }
        }
      }
    }
  ]
}
