{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schema/research-timeline.schema.json",
  "title": "QSOL-CONTROL Recurring Question Research Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timeline_id",
    "protocol",
    "anchor_run_id",
    "question_sha256",
    "question",
    "total_matching_runs",
    "returned_runs",
    "truncated",
    "runs",
    "transitions",
    "timeline_is_truth",
    "authority"
  ],
  "properties": {
    "timeline_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "protocol": {"const": "qsol-control-research-timeline/1"},
    "anchor_run_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "question": {"type": "string", "minLength": 1},
    "total_matching_runs": {"type": "integer", "minimum": 1},
    "returned_runs": {"type": "integer", "minimum": 1, "maximum": 500},
    "truncated": {"type": "boolean"},
    "runs": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"type": "object"}},
    "transitions": {"type": "array", "maxItems": 499, "items": {"type": "object"}},
    "timeline_is_truth": {"const": false},
    "authority": {"const": "longitudinal-comparison-only"}
  }
}
