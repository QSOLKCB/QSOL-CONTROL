{
  "type": "qsol-control-extension-manifest",
  "protocol": "qsol-control-post-roadmap-extensions/1",
  "schema_version": "1.1.0",
  "core_protocol": "QSOL-CONTROL/0.1",
  "core_contract_version": "2.6.0",
  "core_roadmap_complete_through_phase": 10,
  "authority": "none",
  "extensions": {
    "remote_multi_user_gateway": {
      "status": "implemented-reference",
      "runtime": "api/remote_http.py",
      "cli": "tools/remote_gateway.py",
