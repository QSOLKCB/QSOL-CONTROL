      "config_schema": "schema/remote-gateway-config.schema.json",
      "remote_webui": false,
      "non_loopback_requires_tls": true,
      "minimum_presented_bearer_token_characters": 32,
      "tls_private_key_private_on_posix": true,
      "client_self_asserted_caller_identity": false
    },
    "native_mobile_clients": {
      "status": "implemented-reference",
      "contract": "ai/mobile-client-contract.json",
      "ios": "mobile/ios/QSOLControl",
      "android": "mobile/android/app/src/main",
      "app_store_packaging_claimed": false
    },
    "distributed_consensus_coordination": {
      "status": "implemented-external-adapter",
      "runtime": "adapters/consensus.py",
      "cli": "tools/consensus_adapter.py",
      "contract": "ai/consensus-adapter-contract.json",
      "consensus_algorithm_implemented_by_control": false,
      "mutation_intents_only": true,
      "post_proposal_receipt_verification": true,
      "control_storage_mutated_by_adapter": false
